{
  "name": "@chronopic/infra-db",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    }
  },
  "dependencies": {
    "@chronopic/domain": "workspace:*",
    "@chronopic/shared-utils": "workspace:*",
    "better-sqlite3": "^12.0.0"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('Run tests from repo root: pnpm test')\"",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  }
}
